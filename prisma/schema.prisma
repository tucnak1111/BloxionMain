// -----------------------------
// Prisma Client Generator
// -----------------------------
generator client {
  provider = "prisma-client-js"
}

// -----------------------------
// Database Connection
// -----------------------------
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------
// MODELS
// -----------------------------

// Roblox User (Bloxion Account)
model User {
  id              String            @id @default(cuid())
  robloxId        String            @unique              // Roblox User ID
  username        String
  avatarUrl       String?
  isSuspended     Boolean           @default(false)
  suspendedReason String?
  suspendedAt     DateTime?

  // Workspaces they own
  workspaces      Workspace[]

  // Workspaces they are a member of
  memberships     WorkspaceMember[]

  // Discord link (optional)
  discord         DiscordLink?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// Workspace (linked to a Roblox group)
model Workspace {
  id            String            @id @default(cuid())
  ownerId       String
  groupId       String
  allowedRanks  Int[]                                 // Who may access workspace
  createdAt     DateTime          @default(now())

  owner         User              @relation(fields: [ownerId], references: [id])
  members       WorkspaceMember[]
}

// User's membership inside a workspace
model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  rank        Int        @default(0)                 // Roblox group rank
  roles       String[]   @default([])                // Custom Bloxion roles
  joinedAt    DateTime   @default(now())

  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  user        User       @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId]) // A user cannot be added twice
}

// Account suspension logging
model BanLog {
  id        String   @id @default(cuid())
  userId    String
  reason    String
  bannedBy  String   // "bot" or admin user ID
  createdAt DateTime @default(now())
}

// Discord OAuth link (optional for bot integration)
model DiscordLink {
  id         String   @id @default(cuid())
  userId     String   @unique
  discordId  String   @unique
  username   String
  avatarUrl  String?
  linkedAt   DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
}