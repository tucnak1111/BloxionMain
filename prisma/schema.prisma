generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Workspace {
  id            String            @id @default(cuid())
  ownerId       String
  groupId       String
  allowedRanks  Json
  createdAt     DateTime          @default(now())
  owner         User              @relation(fields: [ownerId], references: [id])
  members       Json
}

model User {
  id          String   @id @default(cuid())
  robloxId    String   @unique
  username    String
  avatarUrl   String?
  workspaces  Json
  isSuspended     Boolean  @default(false)
  suspendedReason String?
}


model WorkspaceMember {
  id           String     @id @default(cuid())
  workspaceId  String
  robloxId     String
  username     String
  avatarUrl    String?
  rankId       Int
  rankName     String
  updatedAt    DateTime   @updatedAt

  workspace    Workspace  @relation(fields: [workspaceId], references: [id])
}

model BanLog {
  id          String   @id @default(cuid())
  userId      String
  reason      String
  createdAt   DateTime @default(now())
  bannedBy    String   // moderator ID or "bot"
}
